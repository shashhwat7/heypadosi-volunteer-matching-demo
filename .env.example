# PadosiCast Configuration
PORT=3001
VITE_API_URL=http://localhost:3001

# AWS Configuration (Optional for local simulation, required for real AWS mode)
# If AWS credentials are empty, PadosiCast seamlessly uses high-fidelity local emulation!
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# DynamoDB Configuration
DYNAMODB_TABLE_PREFIX=PadosiCast_
